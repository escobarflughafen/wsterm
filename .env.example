# Copy to .env and edit. Never commit .env.

# Instance identity (prod: portfolio-terminal on 8787, dev: portfolio-terminal-dev on 8788)
COMPOSE_PROJECT_NAME=portfolio-terminal
PORT=8787
BIND_ADDR=127.0.0.1

# Host directory for all app state, and the host user that owns it (`id -u`, `id -g`)
DATA_PATH=./data
APP_UID=10001
APP_GID=10001

# HTTP Basic auth for the whole app (use a long random password: `openssl rand -base64 24`)
APP_USER=admin
APP_PASSWORD=change-me

# Automatic market-data fetch on weekdays (comma-separated HH:MM in TZ_NAME). Empty disables.
FETCH_TIMES=17:20
TZ_NAME=America/Toronto

# IPs allowed to set X-Forwarded-* headers (your reverse proxy). Use its address, not *, if it runs elsewhere.
FORWARDED_ALLOW_IPS=127.0.0.1

MAX_UPLOAD_MB=20
FETCH_COOLDOWN_S=60

# Guest overlay only. Generate GUEST_TOKEN with `openssl rand -hex 32`. The anonymous Cloudflare Quick Tunnel assigns
# a random trycloudflare.com hostname whenever its container is recreated.
GUEST_TOKEN=
